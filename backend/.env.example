# Django
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon Postgres - copia la connection string desde tu dashboard de Neon
# Formato: postgresql://usuario:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/attendance_db?sslmode=require

# CORS - dominios del frontend (React) que pueden consumir la API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Umbral de tolerancia para reconocimiento facial (0.6 es el valor por defecto de face_recognition, menor = más estricto)
FACE_MATCH_TOLERANCE=0.5
